{
  "$wosWorkflow": "1.0",
  "url": "urn:test:workflow-logic-probe",
  "version": "1.0.0",
  "title": "Offline workflow logic probe",
  "impactLevel": "operational",
  "actors": [
    {
      "id": "reviewer",
      "type": "human"
    }
  ],
  "lifecycle": {
    "initialState": "review",
    "states": {
      "review": {
        "type": "atomic",
        "transitions": [
          {
            "event": {
              "kind": "message",
              "name": "finish"
            },
            "target": "done"
          }
        ]
      },
      "done": {
        "type": "final"
      },
      "orphan": {
        "type": "atomic",
        "transitions": [
          {
            "event": {
              "kind": "message",
              "name": "finish"
            },
            "target": "done"
          }
        ]
      }
    }
  }
}
