{
  "candidate": {
    "$wosWorkflow": "1.0",
    "url": "urn:test:signature-runtime",
    "version": "1.0.0",
    "title": "Signature Runtime Fixture Kernel",
    "impactLevel": "operational",
    "actors": [
      {
        "id": "applicant",
        "type": "human"
      },
      {
        "id": "agency",
        "type": "human"
      },
      {
        "id": "witness",
        "type": "human"
      },
      {
        "id": "notary",
        "type": "human"
      },
      {
        "id": "caseworker",
        "type": "human"
      }
    ],
    "caseFile": {
      "fields": {
        "routeApplicant": {
          "type": "boolean"
        },
        "requiresNotary": {
          "type": "boolean"
        }
      }
    },
    "contracts": {
      "signatureContract": {
        "binding": "formspec",
        "ref": "urn:test:formspec:signature",
        "definitionVersion": "1.0.0"
      }
    },
    "lifecycle": {
      "initialState": "draft",
      "states": {
        "draft": {
          "type": "atomic",
          "transitions": [
            {
              "event": {
                "kind": "message",
                "name": "start"
              },
              "target": "signing"
            }
          ]
        },
        "signing": {
          "type": "atomic",
          "tags": [
            "awaiting-signature"
          ],
          "onEntry": [
            {
              "action": "createTask",
              "taskRef": "applicantTask",
              "assignTo": "applicant",
              "contractRef": "signatureContract",
              "completionEvent": "signature.completed",
              "failureEvent": "signature.failed",
              "extensions": {
                "x-wos-signature-profile-key": "signatureProfile",
                "x-wos-signature-step-id": "applicantSigns"
              }
            },
            {
              "action": "createTask",
              "taskRef": "agencyTask",
              "assignTo": "agency",
              "contractRef": "signatureContract",
              "completionEvent": "signature.completed",
              "failureEvent": "signature.failed",
              "extensions": {
                "x-wos-signature-profile-key": "signatureProfile",
                "x-wos-signature-step-id": "agencyApproves"
              }
            },
            {
              "action": "createTask",
              "taskRef": "witnessTask",
              "assignTo": "witness",
              "contractRef": "signatureContract",
              "completionEvent": "signature.completed",
              "failureEvent": "signature.failed",
              "extensions": {
                "x-wos-signature-profile-key": "signatureProfile",
                "x-wos-signature-step-id": "witnessSigns"
              }
            },
            {
              "action": "createTask",
              "taskRef": "notaryTask",
              "assignTo": "notary",
              "contractRef": "signatureContract",
              "completionEvent": "signature.completed",
              "failureEvent": "signature.failed",
              "extensions": {
                "x-wos-signature-profile-key": "signatureProfile",
                "x-wos-signature-step-id": "notaryAttests"
              }
            },
            {
              "action": "createTask",
              "taskRef": "adminTask",
              "assignTo": "caseworker",
              "contractRef": "signatureContract",
              "extensions": {
                "x-wos-signature-profile-key": "signatureProfile",
                "x-wos-signature-step-id": "applicantSigns"
              }
            },
            {
              "action": "startTimer",
              "timerId": "signatureExpiry",
              "duration": "P7D",
              "event": {
                "kind": "timer",
                "timerId": "signatureExpiry",
                "source": "custom",
                "firesAs": "signature.expired"
              }
            }
          ],
          "transitions": [
            {
              "event": {
                "kind": "message",
                "name": "signature.completed"
              },
              "target": "complete"
            },
            {
              "event": {
                "kind": "message",
                "name": "signature.declined"
              },
              "target": "declined"
            },
            {
              "event": {
                "kind": "message",
                "name": "signature.expired"
              },
              "target": "expired"
            },
            {
              "event": {
                "kind": "message",
                "name": "signature.failed"
              },
              "target": "failed"
            }
          ]
        },
        "complete": {
          "type": "final",
          "tags": [
            "signature-complete"
          ]
        },
        "declined": {
          "type": "final",
          "tags": [
            "signature-declined"
          ]
        },
        "expired": {
          "type": "final",
          "tags": [
            "signature-expired"
          ]
        },
        "failed": {
          "type": "final",
          "tags": [
            "signature-voided"
          ]
        }
      }
    },
    "signature": {
      "posturePolicy": {
        "url": "https://example.gov/posture/signature-conformance.json",
        "version": "1.0.0"
      },
      "roles": [
        {
          "id": "applicantSigner",
          "role": "signer",
          "actorId": "applicant",
          "authenticationPolicyKey": "emailOtp"
        }
      ],
      "documents": [
        {
          "id": "application",
          "documentRef": "urn:test:document:application",
          "documentHash": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
          "documentHashAlgorithm": "sha-256",
          "sourceResponseRef": "urn:test:formspec-response:application"
        }
      ],
      "authenticationPolicies": [
        {
          "key": "emailOtp",
          "method": "email-otp",
          "assuranceLevel": "standard"
        }
      ],
      "signingFlow": {
        "type": "sequential",
        "steps": [
          {
            "id": "applicantSigns",
            "roleId": "applicantSigner",
            "documentId": "application",
            "signingIntent": "urn:wos:signing-intent:applicant-signature"
          }
        ],
        "completion": {
          "type": "all-required"
        }
      },
      "evidence": {
        "requiredFields": [
          "response.signature.acceptedAt",
          "response.signature.affirmed",
          "response.signature.documentHash"
        ],
        "consentReference": {
          "consentTextRef": "urn:test:consent:esign",
          "consentVersion": "1.0.0",
          "acceptedAtPath": "response.signature.acceptedAt",
          "affirmationPath": "response.signature.affirmed"
        },
        "identityBinding": {
          "method": "email-otp",
          "assuranceLevel": "standard"
        },
        "custodyHookEligible": true
      }
    }
  },
