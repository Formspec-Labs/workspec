{
  "_note": "AUTHORED-NOT-RUN (see OBL-001 _note). Deadline is P2D (wall-clock; business-day P<N>BD would need a calendar — OBL-010). The trailing 'noop' event carries delay:'P3D' which advances the engine clock past the P2D deadline and drains; evaluate_deadline_expiries marks the obligation Expired and emits ObligationExpired THEN ObligationViolated (reason 'deadline elapsed', no triggerEvent). effectiveAction is 'block' (the policy's onViolation). The exact deadline ISO is not asserted (the ObligationActivated record from the drain carries no deadline value). The 'noop' event is intentionally unmatched by the lifecycle (silently ignored per Kernel S4.9) — its only purpose is to carry the delay; confirm the unmatched-event handling still drains the expiry before the noop is processed.",
  "id": "WOS-CONF-2305-OBL-005-deadline-expiry-violates",
  "rule": "WOS-OBL-TIME-1004",
  "description": "Deadline expiry: a pending obligation whose P2D deadline elapses is marked Expired; ObligationExpired and ObligationViolated are emitted (ADR 0096 §16.2 deadline path).",
  "documents": {
    "kernel": "inline"
  },
  "inline_documents": {
    "kernel": {
      "$wosWorkflow": "1.0",
      "url": "urn:test:OBL-005",
      "version": "1.0.0",
      "title": "OBL-005 Deadline Expiry",
      "status": "active",
      "impactLevel": "rightsImpacting",
      "actors": [
        { "id": "caseworker", "type": "human", "description": "Caseworker who edits the case file" },
        { "id": "underwriter", "type": "human", "description": "Independent underwriter" },
        { "id": "system", "type": "system", "description": "System clock actor" }
      ],
      "lifecycle": {
        "initialState": "open",
        "states": {
          "open": {
            "type": "atomic",
            "transitions": [
              { "event": "caseFileUpdated", "target": "open" }
            ]
          }
        }
      },
      "caseFile": {
        "fields": {
          "income": { "type": "number" }
        }
      },
      "governance": {
        "obligationPolicies": [
          {
            "id": "income-change-review-required",
            "activateWhen": { "on": { "event": "caseFileUpdated" }, "where": "event.field = 'income'" },
            "satisfyWhen": {
              "on": { "event": "underwritingReviewCompleted" },
              "actor": { "role": "underwriter", "notSameAsTriggerActor": true }
            },
            "deadline": { "within": "P2D" },
            "responsibleRole": "underwriter",
            "duplicatePolicy": "ignoreWhilePending",
            "onViolation": "block"
          }
        ]
      },
      "execution": {
        "workflowTimeout": "P90D",
        "defaultTaskTimeout": "P7D",
        "instanceVersioning": "pinned"
      }
    }
  },
  "initial_case_state": {},
  "event_sequence": [
    { "event": "caseFileUpdated", "actor": "caseworker", "data": { "field": "income" } },
    { "event": "noop", "actor": "system", "delay": "P3D" }
  ],
  "expected_transitions": [
    { "from": "open", "target": "open", "event": "caseFileUpdated" }
  ],
  "expected_provenance": [
    {
      "record_kind": "obligationActivated",
      "data": { "policyId": "income-change-review-required", "obligationId": "income-change-review-required#0" }
    },
    {
      "record_kind": "obligationExpired",
      "data": {
        "policyId": "income-change-review-required",
        "obligationId": "income-change-review-required#0",
        "effectiveAction": "block"
      }
    },
    {
      "record_kind": "obligationViolated",
      "data": {
        "policyId": "income-change-review-required",
        "obligationId": "income-change-review-required#0",
        "effectiveAction": "block"
      }
    }
  ]
}
