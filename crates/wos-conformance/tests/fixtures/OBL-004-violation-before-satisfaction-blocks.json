{
  "_note": "AUTHORED-NOT-RUN (see OBL-001 _note). The pre-event gate (drain.rs evaluate_pre_event_gate) runs BEFORE the kernel applies finalApprovalRequested: violateWhen matches while pending and onViolation:block returns early, so the kernel transition open->approved does NOT fire. expected_transitions therefore contains ONLY the activation transition; the blocked event yields no transition. The ObligationViolated record carries effectiveAction:'block' and triggerEvent:'finalApprovalRequested'.",
  "id": "WOS-CONF-2304-OBL-004-violation-before-satisfaction-blocks",
  "rule": "WOS-OBL-RUNTIME-0908",
  "description": "Violation-before-satisfaction: finalApprovalRequested while the obligation is pending is blocked (violateWhen + onViolation:block); ObligationViolated is emitted and the kernel transition does not fire (ADR 0096 §16.2.3 step 4).",
  "documents": {
    "kernel": "inline"
  },
  "inline_documents": {
    "kernel": {
      "$wosWorkflow": "1.0",
      "url": "urn:test:OBL-004",
      "version": "1.0.0",
      "title": "OBL-004 Violation Blocks Premature Approval",
      "status": "active",
      "impactLevel": "rightsImpacting",
      "actors": [
        { "id": "caseworker", "type": "human", "description": "Caseworker who edits the case file" },
        { "id": "underwriter", "type": "human", "description": "Independent underwriter" },
        { "id": "approver", "type": "human", "description": "Final approver" }
      ],
      "lifecycle": {
        "initialState": "open",
        "states": {
          "open": {
            "type": "atomic",
            "transitions": [
              { "event": "caseFileUpdated", "target": "open" },
              { "event": "finalApprovalRequested", "target": "approved" }
            ]
          },
          "approved": { "type": "final" }
        }
      },
      "caseFile": {
        "fields": {
          "income": { "type": "number" }
        }
      },
      "governance": {
        "obligationPolicies": [
          {
            "id": "income-change-review-required",
            "activateWhen": { "on": { "event": "caseFileUpdated" }, "where": "event.field = 'income'" },
            "satisfyWhen": {
              "on": { "event": "underwritingReviewCompleted" },
              "actor": { "role": "underwriter", "notSameAsTriggerActor": true }
            },
            "violateWhen": { "on": { "event": "finalApprovalRequested" } },
            "responsibleRole": "underwriter",
            "duplicatePolicy": "ignoreWhilePending",
            "onViolation": "block"
          }
        ]
      },
      "execution": {
        "workflowTimeout": "P90D",
        "defaultTaskTimeout": "P7D",
        "instanceVersioning": "pinned"
      }
    }
  },
  "initial_case_state": {},
  "event_sequence": [
    { "event": "caseFileUpdated", "actor": "caseworker", "data": { "field": "income" } },
    { "event": "finalApprovalRequested", "actor": "approver" }
  ],
  "expected_transitions": [
    { "from": "open", "target": "open", "event": "caseFileUpdated" }
  ],
  "expected_provenance": [
    {
      "record_kind": "obligationActivated",
      "data": { "policyId": "income-change-review-required", "obligationId": "income-change-review-required#0" }
    },
    {
      "record_kind": "obligationViolated",
      "data": {
        "policyId": "income-change-review-required",
        "obligationId": "income-change-review-required#0",
        "effectiveAction": "block",
        "triggerEvent": "finalApprovalRequested"
      }
    }
  ]
}
