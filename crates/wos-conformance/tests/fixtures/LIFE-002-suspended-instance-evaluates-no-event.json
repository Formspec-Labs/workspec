{
  "id": "LIFE-002-suspended-instance-evaluates-no-event",
  "rule": "K-S11.5",
  "description": "Kernel S11.3: no events are processed while an instance is suspended; evaluating one is refused.",
  "documents": {
    "kernel": "inline"
  },
  "inline_documents": {
    "kernel": {
      "$wosWorkflow": "1.0",
      "url": "urn:test:lifecycle-control",
      "version": "1.0.0",
      "actors": [
        {
          "id": "worker",
          "type": "human"
        },
        {
          "id": "operator",
          "type": "human"
        }
      ],
      "lifecycle": {
        "initialState": "open",
        "states": {
          "open": {
            "type": "atomic",
            "transitions": [
              {
                "event": "advance",
                "target": "review"
              }
            ]
          },
          "review": {
            "type": "atomic",
            "transitions": [
              {
                "event": "close",
                "target": "done"
              }
            ]
          },
          "done": {
            "type": "final"
          }
        }
      },
      "contracts": {}
    }
  },
  "event_sequence": [
    {
      "event": "$suspend",
      "actor": "operator"
    },
    {
      "event": "advance",
      "actor": "worker"
    }
  ],
  "expected_transitions": []
}
