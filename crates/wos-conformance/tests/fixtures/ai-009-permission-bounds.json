{
  "id": "AI-009-permission-bounds",
  "rule": "AI-009",
  "batch": 3,
  "description": "Native supplied-output policy stage only. No invocation, definition validation, review, fallback execution or governed commit claim.",
  "documents": {
    "kernel": "inline"
  },
  "inline_documents": {
    "kernel": {
      "$wosWorkflow": "1.0",
      "url": "urn:test:native-profile:ai-009",
      "version": "1.0.0",
      "title": "Independent native AI replay controls",
      "impactLevel": "operational",
      "actors": [
        {
          "id": "assessor",
          "type": "agent"
        }
      ],
      "agents": [
        {
          "id": "assessor",
          "agentType": "deterministic",
          "modelIdentifier": "literal-rules-model",
          "modelVersion": "7.0.0",
          "deonticConstraints": [
            {
              "id": "amount-bound",
              "kind": "permission",
              "allowedFields": [
                "/amount"
              ],
              "bounds": "output.amount <= 100",
              "onViolation": "reject"
            }
          ]
        }
      ],
      "aiOversight": {},
      "lifecycle": {
        "initialState": "open",
        "states": {
          "open": {
            "type": "atomic",
            "transitions": [
              {
                "event": {
                  "kind": "message",
                  "name": "decide"
                },
                "target": "done"
              }
            ]
          },
          "done": {
            "type": "final"
          }
        }
      }
    }
  },
  "initial_case_state": {
    "retained": 42
  },
  "event_sequence": [
    {
      "event": "decide",
      "actor": "assessor",
      "data": {
        "output": {
          "amount": 101
        },
        "confidenceReport": {
          "overall": 1.0,
          "method": "declared"
        }
      }
    }
  ],
  "expected_transitions": [],
  "expected_provenance": [
    {
      "record_kind": "deonticViolation",
      "data": {
        "constraintId": "amount-bound",
        "action": "reject"
      }
    }
  ],
  "expected_errors": []
}
