{
  "$wosWorkflow": "1.0",
  "version": "1.0.0",
  "title": "Document Extractor Agent Configuration",
  "url": "https://example.test/migrated-fixture",
  "impactLevel": "operational",
  "actors": [
    {
      "id": "system",
      "type": "system"
    },
    {
      "id": "supervisor",
      "type": "human"
    },
    {
      "id": "documentExtractor",
      "type": "agent"
    }
  ],
  "lifecycle": {
    "initialState": "start",
    "states": {
      "start": {
        "type": "atomic",
        "transitions": [
          {
            "target": "done"
          }
        ],
        "onEntry": [
          {
            "action": "invokeService",
            "serviceRef": "documentExtraction"
          }
        ]
      },
      "done": {
        "type": "final"
      }
    }
  },
  "agents": [
    {
      "id": "documentExtractor",
      "approvedVersions": [
        "2025-05-14"
      ],
      "calibration": {
        "required": true,
        "frequency": "P30D",
        "minimumSamples": 100,
        "method": "binning"
      },
      "autonomyPolicy": {
        "escalation": [
          {
            "condition": "agent.calibration.accuracy >= 0.97",
            "targetLevel": "supervisory",
            "description": "Escalate to supervisory when accuracy exceeds 97% in calibration",
            "id": "restoreAfterCalibration",
            "requiredApproverRef": "supervisor",
            "escalationExpiry": "P30D"
          }
        ],
        "demotion": [
          {
            "id": "demoteToManualOnLowAccuracy",
            "condition": "agent.calibration.accuracy < 0.90",
            "targetLevel": "manual",
            "pendingRecalibration": true,
            "description": "Demote to manual when accuracy drops below 90%"
          },
          {
            "id": "demoteToAssistiveOnDegradedAccuracy",
            "condition": "agent.calibration.accuracy < 0.95",
            "targetLevel": "assistive",
            "pendingRecalibration": false,
            "description": "Demote to assistive when accuracy drops below 95%"
          }
        ],
        "maxAutonomy": "supervisory"
      },
      "actionOverrides": [
        {
          "actionRef": "/lifecycle/states/start/onEntry/0",
          "autonomy": "assistive",
          "reviewWindow": "PT4H",
          "confidenceFloor": {
            "threshold": 0.85,
            "onViolation": "escalateToHuman"
          }
        }
      ],
      "agentType": "generative",
      "modelIdentifier": "document-extraction",
      "modelVersion": "2025-05-14",
      "invoker": {
        "kind": "http",
        "endpoint": "https://ai.agency.gov/agents/doc-extractor/v2"
      }
    }
  ]
}
