{
  "$wosWorkflow": "1.0",
  "url": "https://example.org/wf/nda",
  "version": "1.0.0",
  "title": "Mutual NDA",
  "description": "DocuSign-tier signature workflow. Sequential two-party signing with a 30-day expiry timer, reminder cadence, decline path and audit certificate. The signature block is load-bearing: its signing flow orders the signing tasks the lifecycle creates (Signature Profile §2.3).",
  "impactLevel": "operational",
  "caseFile": {
    "fields": {
      "counterpartyName": {
        "type": "string",
        "required": true
      },
      "counterpartyEmail": {
        "type": "string",
        "required": true
      },
      "effectiveDate": {
        "type": "date",
        "required": true
      },
      "termYears": {
        "type": "integer",
        "required": true
      },
      "documentRef": {
        "type": "string",
        "required": true,
        "description": "Trellis-anchored document hash."
      },
      "signedAt": {
        "type": "datetime"
      },
      "auditCertificateRef": {
        "type": "string"
      }
    }
  },
  "actors": [
    {
      "id": "requester",
      "type": "human",
      "role": "internalCounsel"
    },
    {
      "id": "counterparty",
      "type": "human",
      "role": "externalSigner"
    }
  ],
  "contracts": {
    "ndaSignature": {
      "binding": "formspec",
      "ref": "https://example.org/forms/nda-signature",
      "definitionVersion": "1.0.0"
    }
  },
  "lifecycle": {
    "initialState": "drafted",
    "states": {
      "drafted": {
        "type": "atomic",
        "transitions": [
          {
            "event": {
              "kind": "message",
              "name": "authoringCompleted"
            },
            "target": "signing",
            "actor": "requester",
            "tags": [
              "authorCompleted"
            ]
          }
        ]
      },
      "signing": {
        "type": "compound",
        "tags": [
          "awaiting-signature"
        ],
        "initialState": "pending",
        "states": {
          "pending": {
            "type": "atomic",
            "transitions": [
              {
                "event": {
                  "kind": "message",
                  "name": "signature.reminderDue"
                },
                "target": "pending"
              }
            ]
          }
        },
        "onEntry": [
          {
            "action": "createTask",
            "taskRef": "requesterSignature",
            "assignTo": "requester",
            "contractRef": "ndaSignature",
            "completionEvent": "signature.completed",
            "failureEvent": "signature.voided",
            "extensions": {
              "x-wos-signature-profile-key": "signatureProfile",
              "x-wos-signature-step-id": "requesterSigns"
            }
          },
          {
            "action": "createTask",
            "taskRef": "counterpartySignature",
            "assignTo": "counterparty",
            "contractRef": "ndaSignature",
            "completionEvent": "signature.completed",
            "failureEvent": "signature.voided",
            "extensions": {
              "x-wos-signature-profile-key": "signatureProfile",
              "x-wos-signature-step-id": "counterpartySigns"
            }
          },
          {
            "action": "startTimer",
            "timerId": "signatureExpiry",
            "duration": "P30D",
            "event": {
              "kind": "timer",
              "timerId": "signatureExpiry",
              "source": "custom",
              "firesAs": "signature.expired"
            }
          }
        ],
        "transitions": [
          {
            "event": {
              "kind": "message",
              "name": "signature.completed"
            },
            "target": "fully-signed",
            "tags": [
              "determination",
              "binding"
            ]
          },
          {
            "event": {
              "kind": "message",
              "name": "signature.declined"
            },
            "target": "declined"
          },
          {
            "event": {
              "kind": "message",
              "name": "signature.expired"
            },
            "target": "expired"
          },
          {
            "event": {
              "kind": "message",
              "name": "signature.voided"
            },
            "target": "voided"
          }
        ]
      },
      "fully-signed": {
        "type": "final",
        "outcomeCode": "executed",
        "tags": [
          "signature-complete",
          "determination",
          "binding"
        ]
      },
      "declined": {
        "type": "final",
        "outcomeCode": "declined",
        "tags": [
          "signature-declined"
        ]
      },
      "expired": {
        "type": "final",
        "outcomeCode": "expired",
        "tags": [
          "signature-expired"
        ]
      },
      "voided": {
        "type": "final",
        "outcomeCode": "voided",
        "tags": [
          "signature-voided"
        ]
      }
    }
  },
  "signature": {
    "description": "Requester signs first, then the counterparty. Each signer binds their organization, so each step uses the agent-as-officer signing intent, whose floor is OIDC authentication and an as-officer-of signer-authority claim (Signature Profile §2.13.1, §2.14). Each signer affirms the consent text at consentTextRef: \"I have authority to bind my organization to this agreement.\"",
    "roles": [
      {
        "id": "requesterSigner",
        "role": "signer",
        "actorId": "requester",
        "required": true,
        "authenticationPolicyKey": "organizationOidc"
      },
      {
        "id": "counterpartySigner",
        "role": "signer",
        "actorId": "counterparty",
        "required": true,
        "authenticationPolicyKey": "organizationOidc"
      }
    ],
    "documents": [
      {
        "id": "mutualNda",
        "documentRef": "https://example.org/documents/mutual-nda-v1.pdf",
        "documentHash": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
        "documentHashAlgorithm": "sha-256"
      }
    ],
    "authenticationPolicies": [
      {
        "key": "organizationOidc",
        "method": "oidc",
        "assuranceLevel": "aal2"
      }
    ],
    "signingFlow": {
      "type": "sequential",
      "steps": [
        {
          "id": "requesterSigns",
          "roleId": "requesterSigner",
          "documentId": "mutualNda",
          "signingIntent": "urn:wos:signing-intent:agent-as-officer"
        },
        {
          "id": "counterpartySigns",
          "roleId": "counterpartySigner",
          "documentId": "mutualNda",
          "signingIntent": "urn:wos:signing-intent:agent-as-officer",
          "dependsOn": [
            "requesterSigns"
          ]
        }
      ],
      "completion": {
        "type": "all-required"
      }
    },
    "evidence": {
      "requiredFields": [
        "response.signature.acceptedAt",
        "response.signature.affirmed",
        "response.signature.documentHash"
      ],
      "consentReference": {
        "consentTextRef": "https://example.org/consent/nda-signing-authority",
        "consentVersion": "1.0.0",
        "acceptedAtPath": "response.signature.acceptedAt",
        "affirmationPath": "response.signature.affirmed"
      },
      "identityBinding": {
        "method": "oidc",
        "assuranceLevel": "aal2"
      },
      "custodyHookEligible": true
    },
    "reminders": {
      "eventName": "signature.reminderDue",
      "schedule": [
        "P3D",
        "P7D",
        "P14D"
      ]
    },
    "expiryPolicy": {
      "eventName": "signature.expired",
      "after": "P30D"
    },
    "declinePolicy": {
      "transitionId": "signature.declined",
      "reasonRequired": true
    },
    "voidPolicy": {
      "authorizedActorIds": [
        "requester"
      ],
      "reasonRequired": true
    },
    "auditCertificate": {
      "format": "json",
      "includeActorMetadata": true,
      "includeEvidenceLinks": true,
      "signingMode": "sequential"
    }
  },
  "provenance": {
    "tier": "facts"
  },
  "bindings": [
    {
      "on": "fully-signed",
      "writeScope": [
        "signedAt"
      ],
      "mutationSource": "computed",
      "verificationLevel": "attested"
    },
    {
      "on": "fully-signed",
      "writeScope": [
        "auditCertificateRef"
      ],
      "mutationSource": "system-fetched",
      "verificationLevel": "attested"
    }
  ]
}
