{
  "$wosWorkflow": "1.0",
  "url": "https://agency.gov/workflows/benefits-adjudication",
  "version": "1.0.0",
  "title": "Benefits Adjudication",
  "description": "Case-management tier. Multi-stage adjudication of a rights-impacting benefits decision with AI-assisted eligibility review, dual-blind human review, due process (notice + hearing + appeal), statutory deadlines, equity monitoring, and signed determination. Demonstrates every embedded block: governance, agents, aiOversight, signature, advanced, assurance. Abbreviated in places to show shape rather than exhaustively populate sub-blocks.",
  "impactLevel": "rights-impacting",
  "status": "active",
  "intake": {
    "contractRef": "https://agency.gov/forms/benefits-application.formspec.json",
    "mode": "publicIntake"
  },
  "caseFile": {
    "fields": {
      "applicantId": {
        "type": "string",
        "required": true
      },
      "applicationDate": {
        "type": "datetime",
        "required": true
      },
      "programCode": {
        "type": "string",
        "required": true
      },
      "householdSize": {
        "type": "integer",
        "required": true
      },
      "monthlyIncome": {
        "type": "number",
        "required": true
      },
      "documentedAssets": {
        "type": "number",
        "required": false
      },
      "supportingEvidence": {
        "type": "array",
        "required": false
      },
      "eligibilityScore": {
        "type": "number",
        "required": false
      },
      "eligibilityRationale": {
        "type": "string",
        "required": false
      },
      "reviewer1Decision": {
        "type": "string",
        "required": false
      },
      "reviewer2Decision": {
        "type": "string",
        "required": false
      },
      "supervisorDecision": {
        "type": "string",
        "required": false
      },
      "determination": {
        "type": "string",
        "required": false
      },
      "determinationDate": {
        "type": "datetime",
        "required": false
      },
      "appealDeadline": {
        "type": "datetime",
        "required": false
      },
      "reportedRace": {
        "type": "string",
        "required": false,
        "dpvSensitivity": "dpv:SpecialCategoryData",
        "description": "Voluntarily reported race; used only for aggregate equity monitoring (Advanced §3) and negative-counterfactual evidence (Governance §3.4); never a decision input."
      },
      "reportedGender": {
        "type": "string",
        "required": false,
        "dpvSensitivity": "dpv:SpecialCategoryData",
        "description": "Voluntarily reported gender; used only for aggregate equity monitoring (Advanced §3) and negative-counterfactual evidence (Governance §3.4); never a decision input."
      }
    }
  },
  "actors": [
    {
      "id": "applicant",
      "type": "human",
      "role": "respondent"
    },
    {
      "id": "intakeClerk",
      "type": "human",
      "role": "intakeReview"
    },
    {
      "id": "eligibilityAgent",
      "type": "agent",
      "role": "preliminaryAssessment"
    },
    {
      "id": "reviewer1",
      "type": "human",
      "role": "primaryReview"
    },
    {
      "id": "reviewer2",
      "type": "human",
      "role": "independentReview"
    },
    {
      "id": "supervisor",
      "type": "human",
      "role": "determinationAuthority"
    },
    {
      "id": "appealOfficer",
      "type": "human",
      "role": "appellateReview"
    },
    {
      "id": "caseSystem",
      "type": "system",
      "role": "automationSurface"
    }
  ],
  "lifecycle": {
    "initialState": "intake",
    "states": {
      "intake": {
        "type": "atomic",
        "tags": [
          "intakeStart"
        ],
        "stateTimeout": "P5D",
        "transitions": [
          {
            "event": {
              "kind": "message",
              "name": "intakeAccepted"
            },
            "target": "preliminaryReview",
            "actor": "intakeClerk",
            "tags": [
              "intakeAccepted"
            ]
          },
          {
            "event": {
              "kind": "message",
              "name": "intakeRejected"
            },
            "target": "intakeRejected",
            "actor": "intakeClerk",
            "tags": [
              "adverse-decision"
            ]
          }
        ]
      },
      "preliminaryReview": {
        "type": "atomic",
        "stateTimeout": "P3D",
        "transitions": [
          {
            "event": {
              "kind": "message",
              "name": "preliminaryAssessmentCompleted"
            },
            "actor": "eligibilityAgent",
            "target": "dualReview"
          }
        ]
      },
      "dualReview": {
        "type": "parallel",
        "tags": [
          "independentReview",
          "dualBlind"
        ],
        "regions": {
          "primary": {
            "initialState": "reviewer1Pending",
            "states": {
              "reviewer1Pending": {
                "type": "atomic",
                "stateTimeout": "P10D",
                "transitions": [
                  {
                    "event": {
                      "kind": "message",
                      "name": "primaryReviewCompleted"
                    },
                    "target": "reviewer1Done",
                    "actor": "reviewer1",
                    "tags": [
                      "primaryDecision"
                    ]
                  }
                ]
              },
              "reviewer1Done": {
                "type": "final"
              }
            }
          },
          "independent": {
            "initialState": "reviewer2Pending",
            "states": {
              "reviewer2Pending": {
                "type": "atomic",
                "stateTimeout": "P10D",
                "transitions": [
                  {
                    "event": {
                      "kind": "message",
                      "name": "independentReviewCompleted"
                    },
                    "target": "reviewer2Done",
                    "actor": "reviewer2",
                    "tags": [
                      "independentDecision"
                    ]
                  }
                ]
              },
              "reviewer2Done": {
                "type": "final"
              }
            }
          }
        },
        "transitions": [
          {
            "event": {
              "kind": "signal",
              "name": "$join",
              "scope": "instance"
            },
            "target": "reconciliation",
            "guard": "caseFile.reviewer1Decision = caseFile.reviewer2Decision"
          },
          {
            "event": {
              "kind": "signal",
              "name": "$join",
              "scope": "instance"
            },
            "target": "supervisorReview",
            "guard": "caseFile.reviewer1Decision != caseFile.reviewer2Decision",
            "tags": [
              "disagreement"
            ]
          }
        ]
      },
      "reconciliation": {
        "type": "atomic",
        "transitions": [
          {
            "event": {
              "kind": "message",
              "name": "reconciled"
            },
            "target": "determination",
            "actor": "caseSystem",
            "tags": [
              "dualBlindAgreed"
            ]
          }
        ]
      },
      "supervisorReview": {
        "type": "atomic",
        "stateTimeout": "P5D",
        "transitions": [
          {
            "event": {
              "kind": "message",
              "name": "supervisorDecided"
            },
            "target": "determination",
            "actor": "supervisor",
            "tags": [
              "supervisorOverride"
            ]
          }
        ]
      },
      "determination": {
        "type": "atomic",
        "tags": [
          "determinationDraft",
          "awaiting-signature"
        ],
        "transitions": [
          {
            "event": {
              "kind": "message",
              "name": "signature.completed"
            },
            "target": "noticeIssued",
            "tags": [
              "determination",
              "signedDetermination",
              "adverse-decision",
              "signature-complete"
            ]
          },
          {
            "event": {
              "kind": "message",
              "name": "signature.declined"
            },
            "target": "supervisorReview",
            "tags": [
              "signature-declined"
            ]
          }
        ],
        "onEntry": [
          {
            "action": "createTask",
            "taskRef": "signDetermination",
            "assignTo": "supervisor",
            "contractRef": "determinationSignature",
            "completionEvent": "signature.completed",
            "extensions": {
              "x-wos-signature-profile-key": "signatureProfile",
              "x-wos-signature-step-id": "supervisorSigns"
            }
          }
        ]
      },
      "noticeIssued": {
        "type": "atomic",
        "tags": [
          "adverseDecisionNotice",
          "appealEligible"
        ],
        "stateTimeout": "P30D",
        "transitions": [
          {
            "event": {
              "kind": "message",
              "name": "appealFiled"
            },
            "target": "appealUnderReview",
            "actor": "applicant"
          },
          {
            "event": {
              "kind": "timer",
              "timerId": "state",
              "source": "state"
            },
            "target": "finalized",
            "tags": [
              "appealWindowClosed"
            ]
          }
        ]
      },
      "appealUnderReview": {
        "type": "atomic",
        "stateTimeout": "P30D",
        "transitions": [
          {
            "event": {
              "kind": "message",
              "name": "appealResolved"
            },
            "target": "finalized",
            "actor": "appealOfficer",
            "tags": [
              "appealResolved"
            ]
          }
        ]
      },
      "intakeRejected": {
        "type": "atomic",
        "tags": [
          "adverseDecisionNotice",
          "appealEligible"
        ],
        "stateTimeout": "P30D",
        "transitions": [
          {
            "event": {
              "kind": "message",
              "name": "appealFiled"
            },
            "target": "appealUnderReview",
            "actor": "applicant"
          },
          {
            "event": {
              "kind": "timer",
              "timerId": "state",
              "source": "state"
            },
            "target": "intakeClosed",
            "tags": [
              "appealWindowClosed"
            ]
          }
        ]
      },
      "intakeClosed": {
        "type": "final",
        "outcomeCode": "intakeRejected"
      },
      "finalized": {
        "type": "final",
        "outcomeCode": "finalized",
        "tags": [
          "caseClosed"
        ]
      }
    }
  },
  "contracts": {
    "eligibilityRules": {
      "binding": "formspec",
      "ref": "https://agency.gov/contracts/eligibility-policy.json",
      "definitionVersion": "2026.04"
    },
    "determinationSignature": {
      "binding": "formspec",
      "ref": "https://agency.gov/forms/determination-signature.formspec.json",
      "definitionVersion": "1.0.0"
    }
  },
  "bindings": [
    {
      "on": "preliminaryReview/eligibilityAgent.completion",
      "contractRef": "https://agency.gov/contracts/eligibility-output.schema.json",
      "writeScope": [
        "eligibilityScore",
        "eligibilityRationale"
      ],
      "mutationSource": "agent-extracted",
      "verificationLevel": "corroborated"
    },
    {
      "on": "determination",
      "writeScope": [
        "determination",
        "determinationDate",
        "appealDeadline"
      ],
      "mutationSource": "human-entered",
      "verificationLevel": "authoritative"
    }
  ],
  "provenance": {
    "tier": "full"
  },
  "governance": {
    "dueProcess": {
      "adverseDecisionPolicy": {
        "noticeRequired": true,
        "noticeTiming": "beforeEffective",
        "noticeGracePeriod": "P30D",
        "noticeTemplateKey": "adverseDecisionNotice",
        "explanationLevel": "individualized",
        "counterfactualRequired": true,
        "appealMechanism": {
          "enabled": true,
          "appealWindow": "P30D",
          "reviewerConstraint": "independentFromOriginal",
          "reviewerRoles": [
            "appellateReview"
          ],
          "continuationOfServices": false
        }
      }
    },
    "reviewProtocols": [
      {
        "tags": [
          "dualBlind"
        ],
        "protocols": [
          "dualBlind"
        ],
        "description": "Primary and independent reviewers decide without seeing each other's work or the preliminary agent assessment."
      },
      {
        "tags": [
          "independentReview"
        ],
        "protocols": [
          "independentFirst"
        ],
        "description": "The independent reviewer records a judgment before any recommendation is visible."
      }
    ],
    "pipelines": [
      {
        "id": "eligibility",
        "description": "Validates intake data before human review.",
        "stages": [
          {
            "id": "intakeValidation",
            "type": "contract-validation",
            "contractRef": "https://agency.gov/contracts/intake.formspec.json",
            "description": "Validate the application against the intake contract."
          },
          {
            "id": "evidenceCheck",
            "type": "assertion-gate",
            "assertions": [
              {
                "type": "range",
                "expression": "count(supportingEvidence) >= 1",
                "description": "At least one supporting evidence document is attached."
              }
            ],
            "description": "Require supporting evidence before review."
          }
        ]
      }
    ],
    "taskCatalog": [
      {
        "pattern": "primaryReview",
        "verifiable": "no",
        "verificationMethod": "Requires domain expertise; dual-blind review supplies the cross-check.",
        "description": "Primary eligibility review.",
        "slaDefinitions": [
          {
            "id": "decision",
            "expectedDuration": "P10D",
            "calendarType": "business",
            "calendarRef": "https://agency.gov/calendars/federal-2026.json",
            "startAt": "assignment"
          }
        ]
      },
      {
        "pattern": "independentReview",
        "verifiable": "no",
        "verificationMethod": "Requires domain expertise; dual-blind review supplies the cross-check.",
        "description": "Independent eligibility review.",
        "slaDefinitions": [
          {
            "id": "decision",
            "expectedDuration": "P10D",
            "calendarType": "business",
            "calendarRef": "https://agency.gov/calendars/federal-2026.json",
            "startAt": "assignment"
          }
        ]
      },
      {
        "pattern": "supervisorReview",
        "verifiable": "no",
        "verificationMethod": "Requires domain expertise; dual-blind review supplies the cross-check.",
        "description": "Supervisor determination when reviewers disagree.",
        "slaDefinitions": [
          {
            "id": "decision",
            "expectedDuration": "P5D",
            "calendarType": "business",
            "calendarRef": "https://agency.gov/calendars/federal-2026.json",
            "startAt": "assignment"
          }
        ]
      }
    ],
    "delegation": {
      "allowedFor": [
        "primaryReview",
        "independentReview"
      ],
      "verificationLevel": "attested"
    },
    "holds": {
      "kinds": [
        "evidenceRequest",
        "litigation",
        "systemOutage"
      ],
      "stopsClock": true
    },
    "policyParameters": {
      "businessCalendarRef": "https://agency.gov/calendars/federal-2026.json",
      "deadlinePolicy": "businessDays"
    },
    "escalationLevels": [
      {
        "level": 1,
        "trigger": "P3D",
        "target": "supervisor",
        "additionalEditableFields": [
          "overrideRationale"
        ]
      },
      {
        "level": 2,
        "trigger": "P7D",
        "target": "regionalDirector"
      }
    ],
    "audit": {
      "reasoningTier": {
        "requiredForTags": [
          "determination"
        ]
      },
      "counterfactualTier": {
        "requiredForTags": [
          "adverse-decision"
        ],
        "requireProtectedCharacteristics": true
      }
    }
  },
  "agents": [
    {
      "id": "eligibilityAgent",
      "modelIdentifier": "gov-eligibility-classifier",
      "modelVersion": "3.2.0",
      "modelVersionPolicy": "pinned",
      "deonticConstraints": [
        {
          "id": "noDetermination",
          "kind": "prohibition",
          "condition": "present(output.determination)",
          "onViolation": "reject",
          "x-explanation": "Agent assists; only human reviewers determine."
        },
        {
          "id": "requireRationale",
          "kind": "obligation",
          "requirement": "present(output.eligibilityRationale) and length(output.eligibilityRationale) > 0",
          "onViolation": "reject"
        },
        {
          "id": "assessmentFields",
          "kind": "permission",
          "allowedFields": [
            "/eligibilityScore",
            "/eligibilityRationale"
          ],
          "onViolation": "reject"
        }
      ],
      "confidenceFloor": {
        "threshold": 0.75,
        "onViolation": "escalateToHuman"
      },
      "confidenceDecay": {
        "enabled": true,
        "halfLife": "P90D"
      },
      "fallbackChain": [
        {
          "action": "fail"
        }
      ],
      "capabilities": [
        {
          "id": "scoreEligibility",
          "outputContractRef": "https://agency.gov/contracts/eligibility-output.schema.json"
        }
      ],
      "driftMonitoring": {
        "monitors": [
          {
            "evaluationWindow": "P30D",
            "metrics": [
              {
                "name": "demographicParity",
                "method": "custom",
                "threshold": 0.08
              }
            ],
            "alertThresholds": [
              {
                "condition": "demographicParity > 0.08",
                "severity": "warning",
                "action": "notify",
                "notifyRoles": [
                  "supervisor"
                ]
              }
            ]
          }
        ]
      },
      "agentType": "statistical",
      "autonomyPolicy": {
        "maxAutonomy": "assistive"
      }
    }
  ],
  "aiOversight": {
    "defaultAutonomy": "assistive",
    "disclosure": {
      "discloseThatAgentAssisted": true,
      "x-noticeTemplateRef": "https://agency.gov/templates/ai-disclosure.json",
      "x-complianceRefs": [
        "EU-AI-Act-Art-13",
        "OMB-M-24-10"
      ]
    },
    "volumeConstraints": {
      "maxAutonomousPerDay": 0
    }
  },
  "signature": {
    "description": "The supervisor signs the determination. The consent text at consentTextRef reads: \"I attest that I have reviewed the case and the determination is consistent with applicable policy and statute.\"",
    "roles": [
      {
        "id": "supervisorSigner",
        "role": "signer",
        "actorId": "supervisor",
        "required": true,
        "authenticationPolicyKey": "supervisorCredential"
      }
    ],
    "documents": [
      {
        "id": "determination",
        "documentRef": "urn:agency.gov:documents:benefits-determination:v1",
        "documentHash": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
        "documentHashAlgorithm": "sha-256"
      }
    ],
    "authenticationPolicies": [
      {
        "key": "supervisorCredential",
        "method": "credential",
        "assuranceLevel": "ial2",
        "requiresCredentialEvidence": true
      }
    ],
    "signingFlow": {
      "type": "sequential",
      "steps": [
        {
          "id": "supervisorSigns",
          "roleId": "supervisorSigner",
          "documentId": "determination",
          "signingIntent": "urn:wos:signing-intent:agent-as-officer"
        }
      ],
      "completion": {
        "type": "all-required"
      }
    },
    "evidence": {
      "requiredFields": [
        "response.signature.acceptedAt",
        "response.signature.affirmed",
        "response.signature.documentHash"
      ],
      "consentReference": {
        "consentTextRef": "urn:agency.gov:consent:determination-attestation:v1",
        "consentVersion": "1.0.0",
        "acceptedAtPath": "response.signature.acceptedAt",
        "affirmationPath": "response.signature.affirmed"
      },
      "identityBinding": {
        "method": "credential",
        "assuranceLevel": "ial2"
      },
      "custodyHookEligible": true
    },
    "declinePolicy": {
      "transitionId": "signature.declined",
      "reasonRequired": true
    },
    "auditCertificate": {
      "format": "json",
      "includeActorMetadata": true,
      "includeEvidenceLinks": true,
      "signingMode": "sequential"
    }
  },
  "custody": {
    "trustProfileRef": "https://agency.gov/trellis/profiles/public-benefits-trust",
    "anchorRequirements": [
      {
        "on": "signatureAffirmed",
        "anchor": "required"
      },
      {
        "on": "adverse-decision",
        "anchor": "required"
      }
    ],
    "exportBundleRef": "https://agency.gov/wos/export-bundles/benefits-evidence"
  },
  "advanced": {
    "equityGuardrails": {
      "monitors": [
        {
          "id": "approvalRateByRace",
          "metric": "approvalRate",
          "groupBy": "caseFile.reportedRace",
          "maxDisparity": 0.05,
          "evaluationWindow": "P90D",
          "minimumSampleSize": 100,
          "onViolation": "suspend",
          "monitorTags": [
            "determination"
          ],
          "reason": "Demographic parity of approvals by race; applies to human and agent decisions alike."
        },
        {
          "id": "approvalRateByGender",
          "metric": "approvalRate",
          "groupBy": "caseFile.reportedGender",
          "maxDisparity": 0.05,
          "evaluationWindow": "P90D",
          "minimumSampleSize": 100,
          "onViolation": "suspend",
          "monitorTags": [
            "determination"
          ],
          "reason": "Demographic parity of approvals by gender; applies to human and agent decisions alike."
        }
      ]
    },
    "verifiableConstraints": [
      {
        "constraintRef": "noDetermination",
        "verifiable": true,
        "expectedResult": "proven-safe",
        "notes": "The prohibition present(output.determination) is one presence check on the agent output, within the verifiable subset (Advanced §8.2)."
      }
    ],
    "circuitBreaker": {
      "triggers": [
        "agent.confidence.belowFloor",
        "drift.alert",
        "equity.breach"
      ],
      "action": "haltNewAgentInvocations"
    }
  },
  "assurance": {
    "level": "high",
    "attestation": {
      "attesterRole": "agencyCIO",
      "cadence": "quarterly"
    },
    "subjectContinuity": {
      "applicantIdentityProof": "kbaPlusKnownPerson"
    }
  }
}
