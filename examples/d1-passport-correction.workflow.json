{
  "$wosWorkflow": "1.0",
  "actors": [
    {
      "description": null,
      "extensions": {},
      "id": "adjudicator",
      "type": "human"
    },
    {
      "description": null,
      "extensions": {},
      "id": "intakeService",
      "type": "system"
    },
    {
      "id": "applicant",
      "type": "human",
      "description": "Original applicant selected by the host for a photo-only correction task.",
      "extensions": {}
    }
  ],
  "contracts": {
    "reviewContract": {
      "binding": "formspec",
      "ref": "urn:formspec:demo:d1:passport-review",
      "responseMappingRef": "urn:formspec:demo:d1:passport-review:mapping:case"
    },
    "correctionContract": {
      "binding": "formspec",
      "ref": "urn:formspec:demo:d1:passport-photo-correction",
      "responseMappingRef": "urn:formspec:demo:d1:passport-photo-correction:mapping:case",
      "prefillMappingRef": "urn:formspec:demo:d1:passport-photo-correction:mapping:prefill"
    }
  },
  "custody": {
    "anchorRequirements": []
  },
  "decisionTables": [],
  "description": "Candidate native review, photo-only correction and reasoned approval or denial. Original intake filing remains separate immutable evidence; notice clock, expiry, late response and reopening require additional qualification.",
  "extensions": {
    "x-d1-custody-posture": {
      "delegatedComputeVisibility": "Ordinary configured Formspec/WOS server components process plaintext evidence; no external delegated compute is authorized by this workflow",
      "ordinaryReaders": "Formspec source service and scope-bound WOS evidence service; authenticated reviewers only after specific-case authorization",
      "recoveryWithoutUser": true
    },
    "x-d1-definition-pin": {
      "definitionHash": "sha256:7dd5277eae83e2e96ede564c09901607916a1edcfa6364e21f13fb813ed39005",
      "rawDefinitionHash": "sha256:39e4086f46c1c2479f8f3bd87f20a9ad3054973088f1165c0a081a51df5d3b39",
      "receipt": "formspec-studio/demo-authoring/outputs/d1/v0.1.6/receipts/server-definition-hash-v0.1.6.json"
    }
  },
  "governance": {
    "dueProcess": {
      "explanationLevel": "individualized"
    },
    "taskCatalog": [
      {
        "id": "reviewApplication",
        "pattern": "reviewApplication",
        "title": "Review passport application and record an action",
        "description": "Review immutable original evidence and any photo correction. Request a new photo, approve or deny with an individualized reason.",
        "verifiable": "partially",
        "verificationMethod": "Compare the reason with retained original evidence and any separately accepted correction."
      },
      {
        "id": "replacePhoto",
        "pattern": "replacePhoto",
        "title": "Replace the requested passport photo",
        "description": "Submit only a replacement photo linked to the original filing. Prior application answers remain visible through the qualified retained-evidence reader and cannot be edited by this task.",
        "verifiable": "partially",
        "verificationMethod": "Compare the accepted replacement photo and original filing association."
      }
    ]
  },
  "impactLevel": "rights-impacting",
  "intake": {
    "contractRef": "urn:formspec:demo:d1:passport-renewal",
    "contractVersion": "0.1.6",
    "mode": "publicIntake"
  },
  "lifecycle": {
    "initialState": "awaitingReview",
    "states": {
      "awaitingReview": {
        "type": "atomic",
        "onEntry": [
          {
            "action": "createTask",
            "taskRef": "reviewApplication",
            "assignTo": "adjudicator",
            "contractRef": "reviewContract",
            "completionEvent": "review.completed"
          }
        ],
        "transitions": [
          {
            "event": {
              "kind": "message",
              "name": "review.completed"
            },
            "guard": "caseFile.reviewChoice = 'sendBackPhoto'",
            "target": "awaitingPhoto"
          },
          {
            "event": {
              "kind": "message",
              "name": "review.completed"
            },
            "guard": "caseFile.reviewChoice = 'approve'",
            "target": "approved"
          },
          {
            "event": {
              "kind": "message",
              "name": "review.completed"
            },
            "guard": "caseFile.reviewChoice = 'deny'",
            "target": "denied"
          }
        ]
      },
      "awaitingPhoto": {
        "type": "atomic",
        "onEntry": [
          {
            "action": "createTask",
            "taskRef": "replacePhoto",
            "assignTo": "applicant",
            "contractRef": "correctionContract",
            "completionEvent": "photoCorrection.completed"
          }
        ],
        "transitions": [
          {
            "event": {
              "kind": "message",
              "name": "photoCorrection.completed"
            },
            "target": "awaitingReview"
          }
        ]
      },
      "approved": {
        "type": "final"
      },
      "denied": {
        "type": "final"
      }
    },
    "milestones": {}
  },
  "provenance": {
    "tier": "facts"
  },
  "status": "draft",
  "title": "Passport renewal: photo correction and decision",
  "url": "urn:wos:demo:d1:passport-renewal",
  "version": "0.2.0",
  "caseFile": {
    "fields": {
      "reviewChoice": {
        "type": "string"
      },
      "reviewReason": {
        "type": "string"
      },
      "originalFilingRef": {
        "type": "string"
      },
      "correctionFilingRef": {
        "type": "string"
      },
      "correctionPhoto": {
        "type": "object"
      }
    }
  }
}
