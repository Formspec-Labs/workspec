{
  "targetWorkflow": {
    "url": "urn:wos:demo:d1:passport-complete",
    "compatibleVersions": "=0.3.0"
  },
  "version": "0.3.0",
  "title": "D1 complete candidate typed runtime composition",
  "description": "Native IntegrationProfileDocument consumed through with_integration_profile; not the workflow bindings array and not a invented schema marker. Host adapters and delivery semantics require qualification.",
  "bindings": {
    "mockPriorPassportCheck": {
      "type": "request-response",
      "description": "Explicit fictional approved demo mock; adapter returns source, checkedAt, result, available, confirmed and adverse.",
      "inputMapping": {
        "originalFilingRef": "caseFile.originalFilingRef"
      },
      "outputBinding": {
        "caseFile.priorPassportCheck": "$"
      },
      "idempotencyKeyExpression": "caseFile.originalFilingRef & '-mockPriorPassportCheck'"
    },
    "mockSsnCheck": {
      "type": "request-response",
      "description": "Explicit fictional approved demo mock; adapter returns source, checkedAt, result, available, confirmed and adverse.",
