    },
    "sendOutsideDataNotice": {
      "type": "callback",
      "description": "Controlled candidate deferred delivery intent. Runtime persists native request without calling provider; owner must qualify actual receipt and delivery aggregation.",
      "outputBinding": {
        "caseFile.outsideDataNotice": "$"
      },
      "dispatchMode": "deferred",
      "eventType": "com.wos.demo.d1.delivery.request",
      "callbackEventType": "com.wos.demo.d1.delivery.receipt",
      "dataMapping": {
        "referenceNumber": "caseFile.referenceNumber",
        "preferredLanguage": "caseFile.preferredLanguage",
        "reason": "caseFile.priorPassportCheck.result & ' / ' & caseFile.ssnCheck.result",
        "originalFilingRef": "caseFile.originalFilingRef",
        "templateKey": "if caseFile.preferredLanguage = 'es-US' then 'd1OutsideDataDisputeEsUS' else 'd1OutsideDataDisputeEnUS'",
        "noticeContext": "caseFile"
      }
    },
