{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "processId",
    "requestId",
    "checkpointRef"
  ],
  "properties": {
    "status": {
      "enum": [
        "pending",
        "ready"
      ]
    },
    "processId": {
      "$ref": "https://schemas.formspec.io/wos-api/_common/v1#/$defs/ProcessPathId/oneOf/0"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "checkpointRef": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "status": {
          "const": "pending"
        },
        "checkpointRef": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "status": {
          "const": "ready"
        },
        "checkpointRef": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  ],
  "title": "CompletionExportResult"
}
