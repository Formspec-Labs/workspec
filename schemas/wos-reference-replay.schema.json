{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wos-spec.org/schemas/wos-reference-replay.schema.json",
  "title": "Native reference replay inputs and comparisons",
  "description": "Closed software-fixture inputs. Dynamic key, source, clock, reference, and exact-result checks remain native owner obligations. No hosted, human, legal, FNS, or publication qualification.",
  "$ref": "#/$defs/ReferenceReplayAdapters",
  "$defs": {
    "NativeTimeAdvance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beforeEventIndex",
        "duration"
      ],
      "properties": {
        "beforeEventIndex": {
          "type": "integer",
          "minimum": 0
        },
        "duration": {
          "type": "string",
          "pattern": "^P(?:[1-9]|[1-9][0-9]{1,3}|[12][0-9]{4}|3[0-5][0-9]{3}|36[0-4][0-9]{2}|36500)D$"
        }
      }
    },
    "DeterminationTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindingRef",
        "firingOccurrence"
      ],
      "properties": {
        "bindingRef": {
          "$ref": "https://wos-spec.org/schemas/wos-reference-due-process.schema.json#/$defs/Id"
        },
        "firingOccurrence": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "FixtureReceiptSigner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "suite",
        "kidBase64",
        "publicKeyBase64",
        "methodUri"
      ],
      "properties": {
        "id": {
          "$ref": "https://wos-spec.org/schemas/wos-reference-due-process.schema.json#/$defs/Id"
        },
        "suite": {
          "const": "ed25519"
        },
        "kidBase64": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "publicKeyBase64": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "methodUri": {
          "const": "urn:formspec:receipt-method:ed25519-cose-sign1@1"
        }
      }
    },
    "FixtureTransportFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt",
        "outcome"
      ],
      "properties": {
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "outcome": {
          "const": "noEffectFailure"
        }
      }
    },
    "FixtureNoticeTransport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scope",
        "mode",
        "retainedResultsIdentity",
        "failureSchedule"
      ],
      "properties": {
        "id": {
          "$ref": "https://wos-spec.org/schemas/wos-reference-due-process.schema.json#/$defs/Id"
        },
        "scope": {
          "const": "softwareFixture"
        },
        "mode": {
          "const": "sameInstantQualifiedReceipt"
        },
        "retainedResultsIdentity": {
          "$ref": "https://wos-spec.org/schemas/wos-reference-due-process.schema.json#/$defs/Digest"
        },
        "failureSchedule": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FixtureTransportFailure"
          }
        }
      }
    },
    "FixtureSigningCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scope",
        "documentKeyRef",
        "pkcs8Base64",
        "receiptSignerRef",
        "receiptPkcs8Base64"
      ],
      "properties": {
        "id": {
          "$ref": "https://wos-spec.org/schemas/wos-reference-due-process.schema.json#/$defs/Id"
        },
        "scope": {
          "const": "softwareFixture"
        },
        "documentKeyRef": {
          "$ref": "https://wos-spec.org/schemas/wos-reference-due-process.schema.json#/$defs/Id"
        },
        "pkcs8Base64": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "receiptSignerRef": {
          "$ref": "https://wos-spec.org/schemas/wos-reference-due-process.schema.json#/$defs/Id"
        },
        "receiptPkcs8Base64": {
          "type": "string",
          "contentEncoding": "base64"
        }
      }
    },
    "DocumentSigningKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "taskRef",
        "signerHuman",
        "kidBase64",
        "publicKeyBase64",
        "methodUri"
      ],
      "properties": {
        "id": {
          "$ref": "https://wos-spec.org/schemas/wos-reference-due-process.schema.json#/$defs/Id"
        },
        "taskRef": {
          "$ref": "https://wos-spec.org/schemas/wos-reference-due-process.schema.json#/$defs/Id"
        },
        "signerHuman": {
          "$ref": "https://wos-spec.org/schemas/wos-reference-due-process.schema.json#/$defs/Human"
        },
        "kidBase64": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "publicKeyBase64": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "methodUri": {
          "const": "urn:formspec:sig-method:ed25519-cose-sign1@1"
        }
      }
    },
    "EvidenceSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "bytesBase64",
        "sha256"
      ],
      "properties": {
        "id": {
          "$ref": "https://wos-spec.org/schemas/wos-reference-due-process.schema.json#/$defs/Id"
        },
        "role": {
          "enum": [
            "source",
            "review",
            "hearingEvidence",
            "overrideEvidence"
          ]
        },
        "bytesBase64": {
          "type": "string",
          "contentEncoding": "base64"
        },
        "sha256": {
          "$ref": "https://wos-spec.org/schemas/wos-reference-due-process.schema.json#/$defs/Digest"
        }
      }
    },
    "HumanActorBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaredActor",
        "assignedActor"
      ],
      "properties": {
        "declaredActor": {
          "$ref": "https://wos-spec.org/schemas/wos-reference-due-process.schema.json#/$defs/Id"
        },
        "assignedActor": {
          "$ref": "https://wos-spec.org/schemas/wos-reference-due-process.schema.json#/$defs/Human"
        }
      }
    },
    "FixtureInvocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "serviceRef",
        "expectedInput",
        "response",
        "maxInvocations"
      ],
      "properties": {
        "id": {
          "$ref": "https://wos-spec.org/schemas/wos-reference-due-process.schema.json#/$defs/Id"
        },
        "serviceRef": {
          "$ref": "https://wos-spec.org/schemas/wos-reference-due-process.schema.json#/$defs/Id"
        },
        "expectedInput": {},
        "response": {},
        "maxInvocations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "ReferenceInvocationDescriptor": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "documentRef",
            "operationRef"
          ],
          "properties": {
            "kind": {
              "const": "openapi"
            },
            "documentRef": {
              "type": "string",
              "minLength": 1
            },
            "operationRef": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "endpoint"
          ],
          "properties": {
            "kind": {
              "const": "opa"
            },
            "endpoint": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "ReferenceInvocationBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "descriptor",
        "inputMapping",
        "outputBinding"
      ],
      "properties": {
        "id": {
          "$ref": "https://wos-spec.org/schemas/wos-reference-due-process.schema.json#/$defs/Id"
        },
        "kind": {
          "enum": [
            "requestResponse",
            "opaPolicy"
          ]
        },
        "descriptor": {
          "$ref": "#/$defs/ReferenceInvocationDescriptor"
        },
        "inputMapping": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "outputBinding": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ReferenceInvocations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "bindings"
      ],
      "properties": {
        "profile": {
          "const": "referenceInvocations/1"
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReferenceInvocationBinding"
          }
        }
      }
    },
    "TemplateSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "contentType"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "contentType": {
          "enum": [
            "text",
            "structured",
            "appeal-rights",
            "action-required",
            "contact-information"
          ]
        },
        "content": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "required": {
          "type": "boolean"
        },
        "condition": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "NotificationTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "sections"
      ],
      "properties": {
        "category": {
          "enum": [
            "adverse-decision",
            "hold-notification",
            "appeal-acknowledgment",
            "sla-warning",
            "case-status-update",
            "resume-notification"
          ]
        },
        "description": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "subject": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TemplateSection"
          }
        },
        "requiredVariables": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deliveryChannels": {
          "type": "array",
          "items": {
            "enum": [
              "postal",
              "email",
              "portal",
              "sms",
              "in-app"
            ]
          }
        },
        "localeRef": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "authority": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "extensions": {
          "type": "object",
          "maxProperties": 0
        }
      }
    },
    "NotificationTemplateDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "templates"
      ],
      "properties": {
        "$schema": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "targetWorkflow": {
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "templates": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/NotificationTemplate"
          }
        },
        "extensions": {
          "type": "object",
          "maxProperties": 0
        }
      },
      "description": "Maintained native NotificationTemplateDocument adapter DTO; not a complete canonical Delivery document."
    },
    "ReferenceReplayAdapters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "humanActorBindings",
        "trustedReceiptSigners",
        "noticeTransport",
        "retainedEvidence",
        "templates",
        "documentSigningKeys",
        "fixtureSigningCapabilities",
        "invocations"
      ],
      "properties": {
        "timeAdvances": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NativeTimeAdvance"
          }
        },
        "scope": {
          "const": "softwareFixture"
        },
        "humanActorBindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HumanActorBinding"
          }
        },
        "trustedReceiptSigners": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FixtureReceiptSigner"
          }
        },
        "noticeTransport": {
          "$ref": "#/$defs/FixtureNoticeTransport"
        },
        "retainedEvidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceSelection"
          }
        },
        "templates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NotificationTemplateDocument"
          }
        },
        "documentSigningKeys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DocumentSigningKey"
          }
        },
        "fixtureSigningCapabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FixtureSigningCapability"
          }
        },
        "invocations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FixtureInvocation"
          }
        }
      }
    },
    "GovernanceRecipeCommand": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "issueNotice"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "channel",
            "continuationChoice"
          ],
          "properties": {
            "kind": {
              "const": "fileAppeal"
            },
            "channel": {
              "$ref": "https://wos-spec.org/schemas/wos-reference-due-process.schema.json#/$defs/Channel"
            },
            "continuationChoice": {
              "$ref": "https://wos-spec.org/schemas/wos-reference-due-process.schema.json#/$defs/ContinuationChoice"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "reviewerActor",
            "calendarDaysFromFiling"
          ],
          "properties": {
            "kind": {
              "const": "scheduleHearing"
            },
            "reviewerActor": {
              "$ref": "https://wos-spec.org/schemas/wos-reference-due-process.schema.json#/$defs/Id"
            },
            "calendarDaysFromFiling": {
              "type": "integer",
              "minimum": 0,
              "maximum": 36500
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "evidenceRefs"
          ],
          "properties": {
            "kind": {
              "const": "holdHearing"
            },
            "evidenceRefs": {
              "type": "array",
              "items": {
                "$ref": "https://wos-spec.org/schemas/wos-reference-due-process.schema.json#/$defs/SourceRef"
              },
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "outcome",
            "rationale",
            "evidenceRefs"
          ],
          "properties": {
            "kind": {
              "const": "recordDisposition"
            },
            "outcome": {
              "enum": [
                "upheld",
                "reversed"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "evidenceRefs": {
              "type": "array",
              "items": {
                "$ref": "https://wos-spec.org/schemas/wos-reference-due-process.schema.json#/$defs/SourceRef"
              },
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "rationale"
          ],
          "properties": {
            "kind": {
              "const": "requestServiceTermination"
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "calendarDays",
            "rationale",
            "evidenceRefs"
          ],
          "properties": {
            "kind": {
              "const": "extendPreNoticeWindow"
            },
            "calendarDays": {
              "$ref": "https://wos-spec.org/schemas/wos-reference-due-process.schema.json#/$defs/Days"
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "evidenceRefs": {
              "type": "array",
              "items": {
                "$ref": "https://wos-spec.org/schemas/wos-reference-due-process.schema.json#/$defs/SourceRef"
              },
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "applyAdverseEffect"
            }
          }
        }
      ]
    },
    "GovernanceRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationRef",
        "idempotencyToken",
        "actor",
        "command"
      ],
      "properties": {
        "operationRef": {
          "$ref": "https://wos-spec.org/schemas/wos-reference-due-process.schema.json#/$defs/Id"
        },
        "target": {
          "$ref": "#/$defs/DeterminationTarget"
        },
        "idempotencyToken": {
          "$ref": "https://wos-spec.org/schemas/wos-reference-due-process.schema.json#/$defs/Token"
        },
        "actor": {
          "$ref": "https://wos-spec.org/schemas/wos-reference-due-process.schema.json#/$defs/GovernanceActor"
        },
        "command": {
          "$ref": "#/$defs/GovernanceRecipeCommand"
        }
      }
    },
    "FormspecAuthoredSignatureTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signatureId",
        "documentId",
        "signingIntent",
        "documentHash",
        "documentHashAlgorithm",
        "signatureProvider",
        "ceremonyId",
        "signerId",
        "signerName",
        "consentTextRef",
        "consentVersion",
        "affirmationText",
        "consentAccepted"
      ],
      "properties": {
        "signatureId": {
          "type": "string",
          "minLength": 1
        },
        "documentId": {
          "type": "string",
          "minLength": 1
        },
        "signingIntent": {
          "type": "string",
          "minLength": 1
        },
        "documentHash": {
          "type": "string",
          "minLength": 1
        },
        "documentHashAlgorithm": {
          "type": "string",
          "minLength": 1
        },
        "signatureProvider": {
          "type": "string",
          "minLength": 1
        },
        "ceremonyId": {
          "type": "string",
          "minLength": 1
        },
        "signerId": {
          "type": "string",
          "minLength": 1
        },
        "signerName": {
          "type": "string",
          "minLength": 1
        },
        "consentTextRef": {
          "type": "string",
          "minLength": 1
        },
        "consentVersion": {
          "type": "string",
          "minLength": 1
        },
        "affirmationText": {
          "type": "string",
          "minLength": 1
        },
        "consentAccepted": {
          "const": true
        },
        "identityBinding": {}
      }
    },
    "SignatureRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "signingCapabilityRef",
        "signature"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/DeterminationTarget"
        },
        "signingCapabilityRef": {
          "$ref": "https://wos-spec.org/schemas/wos-reference-due-process.schema.json#/$defs/Id"
        },
        "signature": {
          "$ref": "#/$defs/FormspecAuthoredSignatureTemplate"
        }
      }
    },
    "NativeAttemptSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventIndex",
        "kind",
        "occurrence"
      ],
      "properties": {
        "eventIndex": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "enum": [
            "event",
            "taskSubmission",
            "governanceOperation",
            "clock",
            "migration"
          ]
        },
        "occurrence": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "NativeSubject": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "bindingRef",
            "firingOccurrence"
          ],
          "properties": {
            "kind": {
              "const": "determination"
            },
            "bindingRef": {
              "$ref": "https://wos-spec.org/schemas/wos-reference-due-process.schema.json#/$defs/Id"
            },
            "firingOccurrence": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "transition",
            "evaluationOccurrence"
          ],
          "properties": {
            "kind": {
              "const": "decision"
            },
            "transition": {
              "$ref": "https://wos-spec.org/schemas/wos-reference-due-process.schema.json#/$defs/TransitionLocation"
            },
            "evaluationOccurrence": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
